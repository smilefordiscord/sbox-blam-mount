<Project>

  <PropertyGroup>
    <!-- Path to the s&box install. Override with: dotnet build -p:SboxDir="D:\path\to\sbox" -->
    <SboxDir Condition="'$(SboxDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\sbox</SboxDir>
    <SboxManagedDir>$(SboxDir)\bin\managed</SboxManagedDir>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
